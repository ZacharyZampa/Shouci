/target

.DS_Store

# Dictionary source artifacts are hash-pinned elsewhere, never committed.
data/dictionary/sources/*
!data/dictionary/sources/README.md
!data/dictionary/sources.manifest.example.json

# Generated dictionary build + the raw CC-CEDICT source download live locally.
data/dictionary/*.db
data/dictionary/*.db-wal
data/dictionary/*.db-shm
data/dictionary/*.u8.txt
data/dictionary/*.u8.txt.gz

# Local databases are user data, not source.
data/user/*.db
*.db-wal
*.db-shm
*.db-journal