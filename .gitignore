/target

.DS_Store

# Dictionary source artifacts are hash-pinned elsewhere, never committed.
data/dictionaries/sources/*
!data/dictionaries/sources/README.md

# Generated dictionary builds live locally.
data/dictionaries/*.db
data/dictionaries/*.db-wal
data/dictionaries/*.db-shm
data/dictionaries/*.fetched
data/dictionaries/*.fetch.lock

# Local databases are user data, not source.
data/user/*.db
*.db-wal
*.db-shm
*.db-journal